<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingTop="30dp"
        android:paddingRight="22dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/subtitle"
            android:textColor="@color/ink_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:text="@string/status_ready"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vocabularyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vocabulary_loading"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/learnedVocabularyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/learned_vocabulary_empty_summary"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/learnedVocabularyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/view_learned_vocabulary_empty"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/sentenceMemoryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/sentence_memory_title"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/addVocabularyPairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/add_pair_button"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/manualVocabularyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/view_manual_vocabulary_empty"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/mode_title"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/learningModeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/learning_mode_button"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/learning_mode_description"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/autoModeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/auto_mode_button"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/auto_mode_description"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/exerciseTypesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary"
            android:text="自动答题题型开关"
            android:textColor="@color/ink"
            android:textSize="16sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="按题型自由开关；听力和口语有对应按钮时自动跳过。未支持的布局等待手动处理。"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />
        <Button
            android:id="@+id/exerciseMemoryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_secondary"
            android:text="查看其他题型的已学答案"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/aiMatchSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:text="@string/ai_match_mode"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aiSettingsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ai_settings_not_configured"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/aiSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/ai_settings_button"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/aiVocabularyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/view_ai_vocabulary_empty"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/stop_assist"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <Button
            android:id="@+id/importButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/import_words"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/usage_title"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="5dp"
                android:text="@string/usage_body"
                android:textColor="@color/ink_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/privacy_note"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
